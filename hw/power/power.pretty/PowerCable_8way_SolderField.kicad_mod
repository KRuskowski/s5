(footprint PowerCable_8way_SolderField (layer F.Cu) (tedit 0)
  (descr "8-hole THT solder field for the board-to-board power cable -- no connector, solder the 16AWG wires straight in. Pad numbering matches the core-board Mini-Fit Jr 2x4 header (5569-08A1): pins 1-4 top row, 5-8 bottom row, pin 1 above pin 5. 5.0mm pitch, 1.7mm holes (16AWG/9A). Pad 1 = square. Map: 1=VBUS 2=VBUS 3=+24 4=+3V3 / 5=GND 6=GND 7=+5 8=EN.")
  (tags "solder cable power through-hole no-connector minifit 16awg")
  (attr through_hole exclude_from_pos_files)
  (fp_text reference J** (at 7.5 -3.2 0) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value PowerCable_8way (at 7.5 8.2 0) (layer F.Fab)
    (effects (font (size 0.9 0.9) (thickness 0.15))))
  (fp_text user "VBUS" (at 0 -1.9 0)    (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "VBUS" (at 5.0 -1.9 0)  (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "+24"  (at 10.0 -1.9 0) (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "+3V3" (at 15.0 -1.9 0) (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "GND"  (at 0 6.9 0)     (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "GND"  (at 5.0 6.9 0)   (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "+5"   (at 10.0 6.9 0)  (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (fp_text user "EN"   (at 15.0 6.9 0)  (layer F.SilkS) (effects (font (size 0.7 0.7) (thickness 0.11))))
  (pad 1 thru_hole rect   (at 0 0)    (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 5.0 0)  (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at 10.0 0) (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 4 thru_hole circle (at 15.0 0) (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 5 thru_hole circle (at 0 5.0)    (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 6 thru_hole circle (at 5.0 5.0)  (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 7 thru_hole circle (at 10.0 5.0) (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (pad 8 thru_hole circle (at 15.0 5.0) (size 2.9 2.9) (drill 1.7) (layers *.Cu *.Mask))
  (fp_line (start -2.0 -2.1) (end 17.0 -2.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 17.0 -2.1) (end 17.0 7.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 17.0 7.1) (end -2.0 7.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start -2.0 7.1) (end -2.0 -2.1) (layer F.CrtYd) (width 0.05))
)
