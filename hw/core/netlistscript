        Pin(num='3', name='E', func=Pin.types.PASSIVE),
        Pin(num='4', name='C', func=Pin.types.PASSIVE)])
U21.ref = 'U21'
r = res('4.7k'); r[1] += di_p; r[2] += di_la       # 24V -> ~5mA LED current
U21[1] += di_la;  U21[2] += di_n                   # LED: DI+ (via R) -> DI-
D56 = two_pin('1N4148W', 'D56', 'Diode_SMD:D_SOD-123')
D56[1] += di_n; D56[2] += di_la                    # reverse-clamp across LED
D57 = two_pin('SMBJ33CA', 'D57', 'Diode_SMD:D_SMB')
D57[1] += di_p; D57[2] += di_n                     # input surge TVS
U21[3] += gnd;    U21[4] += di_sense               # emitter->GND, collector->STM
r = res('10k'); r[1] += v3v3_sb; r[2] += di_sense  # pull-up (active-low)
U19[12] += di_sense                                # STM reads the DI

# ============================================================
# CHASSIS GROUNDING -- 4-point PE frame bond + one GND<->PE stitch
#   MH1-4 bond the metal frame to protective earth at all four
#   corners (solid, low-impedance, multi-point). GND ties to PE at
#   ONE deliberate point near J1: a 0R hard-bond link in parallel
#   with a 1M bleed + 4.7nF Y-cap. Pick the relationship at
#   assembly -- fit the 0R to hard-bond, or leave just the R||C to
#   HF-couple while staying DC-isolated (kills ground loops).
# ============================================================
for _mh in ('MH1', 'MH2', 'MH3', 'MH4', 'MH5', 'MH6'):
  mh = Part(tool=SKIDL, name='MountingHole_M2.5_PE', ref_prefix='MH',
            dest=NETLIST, footprint='connectors:MountingHole_2.7mm_M2.5_6mmPad',
            pins=[Pin(num='1', name='1', func=Pin.types.PASSIVE)])
  mh.ref = _mh
  mh[1] += earth        # frame -> PE; 6 points (4 corners + 2 mid) on the big board

# GND <-> PE stitch (one controlled bond, tunable at assembly)
r = res('1M'); r[1] += gnd; r[2] += earth                 # bleed / DC leak path
c = cap('4.7nF', 'Capacitor_SMD:C_1206_3216Metric')       # HF bond (use Y-rated)
c[1] += gnd; c[2] += earth
r = res('0R'); r[1] += gnd; r[2] += earth                 # hard-bond link (fit/DNP)

