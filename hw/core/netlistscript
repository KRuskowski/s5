# Shared PSE I2C bus (managed by H3 TWI)
i2c_sda = Net('PSE_I2C_SDA')
i2c_scl = Net('PSE_I2C_SCL')

def wire_pse_common(u, a3_to_gnd):
  # PoE logic runs on the ALWAYS-ON PoE rail (vpse33), not the switched
  # 3.3V -- so the ports stay powered through a management power-cycle.
  u[1]  += vpse33     # VDD (always-on PoE rail)
  u[7]  += gnd        # DGND
  u[22] += gnd        # AGND
  u[28] += vbus54      # VPWR
  decouple(vpse33, gnd, 1)
  c = cap('100nF', 'Capacitor_SMD:C_0805_2012Metric')
  c[1] += vbus54; c[2] += gnd
  u[2] += pse_reset   # shared active-low reset; STM asserts it to shed PoE
  u[3] += i2c_scl; u[4] += i2c_sda; u[5] += i2c_sda
  u[6] += Net(f'{u.ref}_INT_N')
  u[23] += gnd if a3_to_gnd else vpse33  # A3 I2C address strap (GND=0 / vpse33=1), NOT a rail
  u[24] += vpse33     # SHTDWN pin (active-low) -- tied high = disabled. NOT a power feed;
  # shows as VDD_3V3_PSE in KiCad. HW fast-shutdown intentionally unused; PoE is shed via
  # the I2C RESET line (pin 2) instead.
  u[25] += Net(f'{u.ref}_AIN')
  u[26] += Net(f'{u.ref}_AOUT')

# Per-channel FET circuit
def wire_pse_channel(u, sen_pin, drain_pin, gate_pin, vp_net,
                     qref):
  gate = Net(f'{u.ref}_GATE{gate_pin}')
  drain_s = Net(f'{u.ref}_DRAIN{drain_pin}')
  src = Net(f'{u.ref}_SRC{sen_pin}')
  sen = Net(f'{u.ref}_SEN{sen_pin}')
  u[gate_pin] += gate
  u[drain_pin] += drain_s
  u[sen_pin] += sen
  q = nfet(qref)
  q[1] += gate; q[2] += vbus54; q[3] += src
  r = res('47'); r[1] += vbus54; r[2] += drain_s
  # 0.25 ohm sense resistor
  _rref[0] += 1
  r = Part(
    tool=SKIDL, name='R', ref_prefix='R', dest=NETLIST,
    value='0.25', footprint='Resistor_SMD:R_0805_2012Metric',
    pins=[Pin(num='1', name='1', func=Pin.types.PASSIVE),
          Pin(num='2', name='2', func=Pin.types.PASSIVE)])
  r.ref = f'R{_rref[0]}'
  r[1] += src; r[2] += vp_net
  r = res('22'); r[1] += src; r[2] += sen

# U9 -> ports 1-4
