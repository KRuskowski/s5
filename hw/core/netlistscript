U19[11] += relay_gate                        # STM fault-relay drive
r = res('100k'); r[1] += relay_gate; r[2] += gnd   # default-OFF = fail-safe
# ONE pluggable SIGNAL block J11 (relay contact + DI), on a DIFFERENT pitch
# than the 5.08mm power terminal -- Phoenix MC 1,5 / 3.5mm, threaded flange.
# The plugs are not interchangeable, so 24V power can never be mis-inserted
# into the signal connector.  1=COM 2=NO 3=NC (dry Form-C alarm) | 4=DI+
# 5=DI- (isolated input).  Power stays on its own MSTB 5.08mm block (J1).
J11 = Part(tool=SKIDL, name='MC1,5/5-GF-3,5_1843826', ref_prefix='J', dest=NETLIST,
  footprint='Connector_Phoenix_MC:PhoenixContact_MC_1,5_5-GF-3.5_1x05_P3.50mm_Horizontal_ThreadedFlange',
  pins=[Pin(num='1', name='COM', func=Pin.types.PASSIVE),
        Pin(num='2', name='NO',  func=Pin.types.PASSIVE),
        Pin(num='3', name='NC',  func=Pin.types.PASSIVE),
        Pin(num='4', name='DI+', func=Pin.types.PASSIVE),
        Pin(num='5', name='DI-', func=Pin.types.PASSIVE)])
J11.ref = 'J11'
relay_com = Net('RELAY_COM'); J11[1] += relay_com
relay_no  = Net('RELAY_NO');  J11[2] += relay_no
relay_nc  = Net('RELAY_NC');  J11[3] += relay_nc
K1['3'] += relay_com; K1['6'] += relay_com    # COM (both far-column pads)
K1['1'] += relay_no;  K1['4'] += relay_nc     # NO, NC
D55 = two_pin('SMBJ33CA', 'D55', 'Diode_SMD:D_SMB')
D55[1] += relay_com; D55[2] += relay_no       # bidir TVS COM-NO (field surge)

# Digital input -- isolated 24V-sense of an external dry/PLC contact.
# The supervisor reads it (active-low) and reports up via the T113
# (SNMP/UI/MODBUS), even while the SoC is down. Opto-isolated, TVS'd.
di_sense = Net('DI_SENSE')
di_la    = Net('DI_LED_A')
di_p = Net('DI_TERM_P'); J11[4] += di_p            # DI+ terminal
di_n = Net('DI_TERM_N'); J11[5] += di_n            # DI- terminal
U21 = Part(tool=SKIDL, name='EL357N', ref_prefix='U', dest=NETLIST,
  footprint='Package_SO:SOP-4_3.8x4.1mm_P2.54mm',
  pins=[Pin(num='1', name='A', func=Pin.types.PASSIVE),
