#!/usr/bin/env python3
"""
V5: 5-port managed GbE PoE switch with Allwinner T113-S3.

KSZ9477S 7-port switch:
  - Ports 1-5: 10/100/1000 copper PHY -> LPJG0926HENL PoE+
    GbE MagJack (integrated magnetics + LEDs + PoE center taps).
  - Port 6: RGMII (MAC) -> Allwinner T113-S3 (management CPU).
  - Port 7: SGMII/SerDes -> left unused (terminated, S_REXT kept).

Allwinner T113-S3 (eLQFP128, 14x14x1.4mm) -- SiP 128MB DDR3, so
NO external DRAM and NO DDR signal layer. Manages the KSZ over
SPI0; debug UART0; USB; SPI boot flash. EMAC drives KSZ port 6
over RGMII from the PG bank (frees all 5 copper PHYs for users).

PoE PSE: 2x TPS23861 (4 channels each) covers all 5 ports.
Power comes from the SEPARATE s5-power board via a Molex Micro-Fit
2x6 interconnect (J9): VBUS_54V (PoE), VIN_24V (protected, for the
always-on standby LDOs + fault relay), VDD_5V, VDD_3V3, MAIN_EN.
All switching (input protection, LM5122 54V boost, TPS54560 5V buck,
AMS1117 3V3 LDO) lives on the power board; this board keeps only the
point-of-load rails: 2.5 / 1.2V (KSZ) + 0.9V buck (T113 VDD-CORE) +
1.8V LDO (VDD18-DRAM). MAIN_EN is driven back to gate the buck.

4-layer stackup intent (no external DDR3 routing).

Pin sources:
  T113-S3:   Allwinner T113-S3 Datasheet v1.6, sec 4.2/4.3.
             Real ball numbers; see T113S3_PINMAP.md.
  KSZ9477S:  DS00002392C Table 3-1.
  TPS54560/TPS23861: TI datasheets.

NOTE: only ONE dedicated T113 ground pin (AGND=91); the eLQFP128
exposed pad is the main GND return -- EP->GND is mandatory.
"""

import os, glob
# Delete any cached SKiDL backup lib to prevent stale part defs
# from overriding the inline Part() definitions below.
_here = os.path.dirname(os.path.abspath(__file__))
for _f in glob.glob(os.path.join(_here, '*_sklib.py')):
  os.remove(_f)

from skidl import *

# ============================================================
# Stable ref counters
# ============================================================
_cref = [0]
_rref = [0]
_lref = [0]
_qref = [0]
_ledref = [0]
_fbref = [0]

def cap(value, fp='Capacitor_SMD:C_0402_1005Metric'):
  _cref[0] += 1
  c = Part(
    tool=SKIDL, name='C', ref_prefix='C',
    dest=NETLIST, value=value, footprint=fp,
    pins=[
      Pin(num='1', name='1', func=Pin.types.PASSIVE),
      Pin(num='2', name='2', func=Pin.types.PASSIVE),
    ])
  c.ref = f'C{_cref[0]}'
  return c

def res(value, fp='Resistor_SMD:R_0402_1005Metric'):
  _rref[0] += 1
  r = Part(
    tool=SKIDL, name='R', ref_prefix='R',
    dest=NETLIST, value=value, footprint=fp,
    pins=[
      Pin(num='1', name='1', func=Pin.types.PASSIVE),
      Pin(num='2', name='2', func=Pin.types.PASSIVE),
    ])
  r.ref = f'R{_rref[0]}'
  return r

def inductor(value, fp='Inductor_SMD:L_1210_3225Metric'):
  _lref[0] += 1
  l = Part(
    tool=SKIDL, name='L', ref_prefix='L',
    dest=NETLIST, value=value, footprint=fp,
    pins=[
      Pin(num='1', name='1', func=Pin.types.PASSIVE),
      Pin(num='2', name='2', func=Pin.types.PASSIVE),
    ])
  l.ref = f'L{_lref[0]}'
  return l

def ferrite(value='220R@100MHz', fp='Inductor_SMD:L_0603_1608Metric'):
  """Series ferrite bead (FB prefix). 220R@100MHz 0603, low DCR. Isolates the
  KSZ analog supplies (AVDDH/AVDDL) from the digital rails per Microchip HW
  Design Checklist DS00004151A section 3.2. Pick a bead with DCR <=0.05R (1.2V)
  / <=0.1R (2.5V) rated >=500mA/400mA when sourcing."""
  _fbref[0] += 1
  fb = Part(
    tool=SKIDL, name='FerriteBead', ref_prefix='FB',
    dest=NETLIST, value=value, footprint=fp,
    pins=[
      Pin(num='1', name='1', func=Pin.types.PASSIVE),
      Pin(num='2', name='2', func=Pin.types.PASSIVE),
    ])
  fb.ref = f'FB{_fbref[0]}'
  return fb

def led(value='LED'):
  """Status LED -- Osram Mini TOPLED Lx M676 (under the 1278.1004 light
  guide). pin 1=A(anode), pin 2=K(cathode). `value` = colour order code
  (red/orange/yellow/green all Vf~2V, fine on the shared 270R)."""
  _ledref[0] += 1
  d = Part(
    tool=SKIDL, name='LED', ref_prefix='D',
    dest=NETLIST, value=value,
    footprint='connectors:Osram_MiniTOPLED_LSM676',
    pins=[
      Pin(num='1', name='A', func=Pin.types.PASSIVE),
      Pin(num='2', name='K', func=Pin.types.PASSIVE),
    ])
  d.ref = f'D{_ledref[0] + 2}'  # D1=SS54, D2=1N4148
  return d

def nfet(ref_des):
  """N-channel MOSFET in SOT-223: pin 1=G, 2=D(tab), 3=S."""
  _qref[0] += 1
  q = Part(
    tool=SKIDL, name='NMOS', ref_prefix='Q',
    dest=NETLIST,
    footprint='Package_TO_SOT_SMD:SOT-223-3_TabPin2',
    pins=[
      Pin(num='1', name='G', func=Pin.types.INPUT),
      Pin(num='2', name='D', func=Pin.types.PASSIVE),
      Pin(num='3', name='S', func=Pin.types.PASSIVE),
    ])
  q.ref = ref_des
  return q

def decouple(rail, gnd, n, value='100nF',
             fp='Capacitor_SMD:C_0402_1005Metric'):
  """Place n decoupling caps between rail and gnd."""
  for _ in range(n):
    c = cap(value, fp)
    c[1] += rail
    c[2] += gnd

# ============================================================
# Power nets
# ============================================================
vin24 = Net('VIN_24V')
vbus54 = Net('VBUS_54V')     # 54V PoE rail (from boost)
vdd5  = Net('VDD_5V')
earth = Net('PE')            # protective earth
vdd33 = Net('VDD_3V3')
vdd25 = Net('VDD_2V5')      # KSZ AVDDH/VDDHS
vdd12 = Net('VDD_1V2')      # KSZ core rails
vcore = Net('VDD_CORE')     # T113-S3 VDD-CORE 0.9V (buck)
vdd18 = Net('VDD_1V8')      # T113-S3 VDD18-DRAM (LDO)
gnd   = Net('GND')
v3v3_sb = Net('VDD_3V3_SB')  # always-on standby (supervisor + dumb wd)
main_en = Net('MAIN_EN')     # -> power-board buck EN (via J9); STM/dumb-wd cut
vpse33 = Net('VDD_3V3_PSE')  # PoE housekeeping 3.3V -- always on (rides cycle)
pse_reset = Net('PSE_RESET_N') # STM pulls low = reset PSEs = shed PoE (thermal)

# ============================================================
# Board-to-board POWER INTERCONNECT -- Samtec PowerStrip MP, right-angle,
# COPLANAR edge-to-edge mate, NO cable. The CORE board carries the MPT-06
# terminal (male blades); the POWER board carries the MPS-06 socket (female,
# recessed contacts -- it is the energized SOURCE side, so no exposed live
# blades when the boards are separated). 6 positions, each a 20A+ dual-blade
# landed on 6 paralleled THT pins (36 holes). The two boards face each other,
# so MPT blade N mates MPS position N.
# blade -> net: 1=VBUS_54V 2=GND 3=VIN_24V 4=VDD_5V 5=VDD_3V3 6=MAIN_EN
# VIN_24V = protected 24V for the always-on standby LDOs (U18/U20) + relay K1.
# ============================================================
J9 = Part(tool=SKIDL, name='MPT-06-01-RA', ref_prefix='J', dest=NETLIST,
  footprint='connectors:MPT-06-01-XX-X-RA-SD',
  pins=[Pin(num=str(i), name=str(i), func=Pin.types.PASSIVE)
        for i in range(1, 37)])
J9.ref = 'J9'
# blade b (0..5) = pads 6b+1 .. 6b+6, all tied to one net
for _b, _net in enumerate((main_en, gnd, vin24, vdd5, vdd33, vbus54)):
  for _p in range(1, 7):
    J9[str(_b * 6 + _p)] += _net
# VBUS-54V entry bulk (>=100V rated -- MUST NOT drop to a 0805/50V part)
c = cap('10uF', 'Capacitor_SMD:C_1210_3225Metric'); c[1] += vbus54; c[2] += gnd
# (vin24/vdd5/vdd33 entry bulk is added by the per-rail loop below.)

def two_pin(name, ref, fp):
  """Generic 2-terminal part (fuse / TVS / MOV / NTC / zener / switch)."""
  import re as _re
  p = Part(tool=SKIDL, name=name, ref_prefix=_re.sub(r'\d+$', '', ref),
           dest=NETLIST, footprint=fp,
           pins=[Pin(num='1', name='1', func=Pin.types.PASSIVE),
                 Pin(num='2', name='2', func=Pin.types.PASSIVE)])
  p.ref = ref
  return p

# rail-entry bulk decoupling at the interconnect
# (vin24 here = PROTECTED 24V; fuse/reverse-pol/TVS are on the power board)
for _n in (vin24, vdd5, vdd33):
  c = cap('10uF', 'Capacitor_SMD:C_1206_3216Metric'); c[1] += _n; c[2] += gnd

# ============================================================
# LDO regulators
# ============================================================
def ldo_sot223(name, ref_des):
  """SOT-223 LDO: pin 1=GND, pin 2=VO, pin 3=VI."""
  u = Part(
    tool=SKIDL, name=name, ref_prefix='U', dest=NETLIST,
    footprint='Package_TO_SOT_SMD:SOT-223-3_TabPin2',
    pins=[
      Pin(num='1', name='GND', func=Pin.types.PWRIN),
      Pin(num='2', name='VO',  func=Pin.types.PWROUT),
      Pin(num='3', name='VI',  func=Pin.types.PWRIN),
    ])
  u.ref = ref_des
  return u

def ldo_sot23(name, ref_des):
  """SOT-23-5 LDO (AP2112K): 1=VIN,2=GND,3=EN,5=VOUT."""
  u = Part(
    tool=SKIDL, name=name, ref_prefix='U', dest=NETLIST,
    footprint='Package_TO_SOT_SMD:SOT-23-5',
    pins=[
      Pin(num='1', name='VIN',  func=Pin.types.PWRIN),
      Pin(num='2', name='GND',  func=Pin.types.PWRIN),
      Pin(num='3', name='EN',   func=Pin.types.INPUT),
      Pin(num='4', name='NC',   func=Pin.types.NOCONNECT),
      Pin(num='5', name='VOUT', func=Pin.types.PWROUT),
    ])
  u.ref = ref_des
  return u

# VDD_3V3 arrives from the power board via J9[9] (AMS1117 3V3 LDO moved there).
# U3: AP2112K-2.5 (3.3V -> 2.5V, KSZ AVDDH/VDDHS)
U3 = ldo_sot23('AP2112K-2.5', 'U3')
U3[1] += vdd33; U3[2] += gnd; U3[3] += vdd33; U3[5] += vdd25
# U4: AP2112K-1.2 (3.3V -> 1.2V, KSZ + H3 VDD_SYS/CPUS)
# NOTE: combined 1.2V load may approach AP2112K 600mA limit;
# upgrade to a 1.2V buck if bench current is high.
U4 = ldo_sot23('AP2112K-1.2', 'U4')
U4[1] += vdd33; U4[2] += gnd; U4[3] += vdd33; U4[5] += vdd12

# ============================================================
# 0.9V core rail -- TLV62569 buck (5V -> 0.9V), SOT-23-6
# for T113-S3 VDD-CORE. Pin 1=SW,2=GND,3=EN,4=FB,5=VIN,6=MODE
# ============================================================
U11 = Part(
  # TLV62569P (DDC = SOT23-6, has PG). Pinout per datasheet SLVSDG1C:
  # 1=EN 2=GND 3=SW 4=VIN 5=PG 6=FB. (s5 had a fabricated pinout w/ a
  # nonexistent MODE pin and VIN/FB/SW/EN scrambled.)
  tool=SKIDL, name='TLV62569PDDCR', ref_prefix='U', dest=NETLIST,
  footprint='Package_TO_SOT_SMD:SOT-23-6',
  pins=[
    Pin(num='1', name='EN',  func=Pin.types.INPUT),
    Pin(num='2', name='GND', func=Pin.types.PWRIN),
    Pin(num='3', name='SW',  func=Pin.types.PWROUT),
    Pin(num='4', name='VIN', func=Pin.types.PWRIN),
    Pin(num='5', name='PG',  func=Pin.types.OPENCOLL),
    Pin(num='6', name='FB',  func=Pin.types.INPUT),
  ])
U11.ref = 'U11'
U11[4] += vdd5   # VIN
U11[2] += gnd
U11[1] += vdd5   # EN pin -- tied high = always enabled. NOT a power feed; shows as VDD_5V in KiCad.
core_sw = Net('CORE_SW')
U11[3] += core_sw   # SW
l = inductor('1uH', 'Inductor_SMD:L_0805_2012Metric')
l[1] += core_sw; l[2] += vcore
# PG is open-drain: pull up to VIN
core_pg = Net('CORE_PG'); U11[5] += core_pg
r = res('100k'); r[1] += vdd5; r[2] += core_pg
decouple(vdd5, gnd, 1, '10uF', 'Capacitor_SMD:C_0805_2012Metric')
for _ in range(2):
  c = cap('22uF', 'Capacitor_SMD:C_0805_2012Metric')
  c[1] += vcore; c[2] += gnd
# FB divider for 0.9V (0.6V ref): R_top/R_bot=(0.9-0.6)/0.6=0.5
fb09 = Net('FB_0V9'); U11[6] += fb09
r = res('50k');  r[1] += vcore; r[2] += fb09
r = res('100k'); r[1] += fb09;  r[2] += gnd

# ============================================================
# 1.8V rail -- AP2112K-1.8 LDO (3.3V -> 1.8V) for T113
# VDD18-DRAM (SiP DDR3 I/O; low current).
# ============================================================
U12 = ldo_sot23('AP2112K-1.8', 'U12')
U12[1] += vdd33; U12[2] += gnd; U12[3] += vdd33; U12[5] += vdd18
for _ in range(2):
  c = cap('10uF', 'Capacitor_SMD:C_0805_2012Metric')
  c[1] += vdd18; c[2] += gnd

# Bulk caps per rail
for rail in [vin24, vdd5, vdd33, vdd25, vdd12, vcore, vdd18]:
  c = cap('10uF', 'Capacitor_SMD:C_0805_2012Metric')
  c[1] += rail; c[2] += gnd

# ============================================================
# KSZ9477S -- 128-TQFP-EP, DS00002392C
# ============================================================
U1 = Part(
  tool=SKIDL, name='KSZ9477S', ref_prefix='U', dest=NETLIST,
  footprint='chips:QFP40P1600X1600X120-129N',
  pins=[
    Pin(num=str(i), name=f'P{i}', func=Pin.types.BIDIR)
    for i in range(1, 129)
  ] + [
    Pin(num='129', name='EP', func=Pin.types.PASSIVE),
  ] + [
    Pin(num=f'E_{i}', name=f'EP_{i}', func=Pin.types.PASSIVE)
    for i in range(1, 65)
  ])
U1.ref = 'U1'

# KSZ9477S power pins.
# The analog supplies AVDDH (2.5V PHY) and AVDDL (1.2V analog core) are fed
# through series ferrite beads off the digital rails, per Microchip HW Design
# Checklist DS00004151A sec 3.2 ("a series ferrite bead should be placed between
# the analog supply and the board supply"). Digital/SGMII rails (DVDDL, VDDLS,
# VDDHS, VDDIO) stay directly on the shared rails.
avddh = Net('KSZ_AVDDH')   # 2.5V analog PHY, post-ferrite from VDD_2V5
avddl = Net('KSZ_AVDDL')   # 1.2V analog core, post-ferrite from VDD_1V2
fb = ferrite(); fb[1] += vdd25; fb[2] += avddh   # FB1: VDD_2V5 -> AVDDH
fb = ferrite(); fb[1] += vdd12; fb[2] += avddl   # FB2: VDD_1V2 -> AVDDL
for p in [3, 14, 19, 30, 36, 41, 114, 119, 124]:  # AVDDL 1.2 (analog, beaded)
  U1[p] += avddl
for p in [10, 22, 33, 44, 111, 122, 128]:          # AVDDH 2.5 (analog, beaded)
  U1[p] += avddh
for p in [11, 23, 45, 56, 66, 70, 87, 104, 110]:   # DVDDL 1.2 (digital)
  U1[p] += vdd12
for p in [61, 68, 99]:                              # VDDIO 3.3
  U1[p] += vdd33
for p in [71, 84]:                                  # VDDLS 1.2 (SGMII)
  U1[p] += vdd12
for p in [72, 83]:                                  # VDDHS 2.5 (SGMII)
  U1[p] += vdd25
for p in [46, 47, 69, 75, 77, 80, 107, 109, 123, 129]:  # GND
  U1[p] += gnd
for i in range(1, 65):                              # EP segments
  U1[f'E_{i}'] += gnd

# KSZ decoupling: 0.1uF per power pin, on the same (post-ferrite) net as the pin
# it serves, plus 22uF low-ESR ceramic bulk on each beaded analog rail at the
# device (per checklist). Total 0.1uF count unchanged (32): now split by rail.
decouple(avddh, gnd, 7)    # 7 AVDDH pins
decouple(avddl, gnd, 9)    # 9 AVDDL pins
decouple(vdd25, gnd, 2)    # 2 VDDHS pins
decouple(vdd12, gnd, 11)   # 9 DVDDL + 2 VDDLS
decouple(vdd33, gnd, 3)    # 3 VDDIO pins
c = cap('22uF', 'Capacitor_SMD:C_0805_2012Metric'); c[1] += avddh; c[2] += gnd
c = cap('22uF', 'Capacitor_SMD:C_0805_2012Metric'); c[1] += avddl; c[2] += gnd

# KSZ crystal 25MHz
Y1 = Part(
  tool=SKIDL, name='Crystal_25MHz', ref_prefix='Y',
  dest=NETLIST, value='25MHz',
  footprint='Crystal:Crystal_SMD_2016-4Pin_2.0x1.6mm',
  pins=[
    Pin(num='1', name='1', func=Pin.types.PASSIVE),
    Pin(num='2', name='2', func=Pin.types.PASSIVE),
  ])
xi = Net('KSZ_XI'); xo = Net('KSZ_XO')
U1[126] += xi; U1[125] += xo
Y1[1] += xi; Y1[2] += xo
c = cap('15pF'); c[1] += xi; c[2] += gnd
c = cap('15pF'); c[1] += xo; c[2] += gnd

# KSZ reference resistors
r = res('6.04k'); iset = Net('KSZ_ISET'); r[1] += iset; r[2] += gnd
U1[127] += iset
r = res('191'); srext = Net('KSZ_S_REXT'); r[1] += srext; r[2] += gnd
U1[76] += srext   # port-7 SerDes S_REXT (kept even though P7 unused)

# KSZ reset RC + diode
reset_net = Net('KSZ_RESET_N'); U1[96] += reset_net
r = res('10k'); r[1] += vdd33; r[2] += reset_net
c = cap('10uF', 'Capacitor_SMD:C_0805_2012Metric')
c[1] += reset_net; c[2] += gnd
D2 = Part(
  tool=SKIDL, name='D_1N4148', ref_prefix='D',
  dest=NETLIST, value='1N4148', footprint='Diode_SMD:D_SOD-323',
  pins=[
    Pin(num='1', name='K', func=Pin.types.PASSIVE),
    Pin(num='2', name='A', func=Pin.types.PASSIVE),
  ])
D2.ref = 'D2'
D2[2] += reset_net; D2[1] += vdd33

# KSZ SPI management (to H3 SPI0) + INT
spi_clk  = Net('SPI_CLK')
spi_mosi = Net('SPI_MOSI')
spi_miso = Net('SPI_MISO')
spi_cs   = Net('SPI_CS_N')
intrp    = Net('INTRP_N')
U1[101] += spi_clk
U1[98]  += spi_mosi
U1[97]  += spi_miso
U1[100] += spi_cs
U1[94]  += intrp
# MOSI/CS high at reset selects SPI mode
for net, val in [(spi_mosi, '4.7k'), (spi_cs, '4.7k'),
                 (intrp, '10k')]:
  r = res(val); r[1] += vdd33; r[2] += net

# KSZ misc straps
pme = Net('PME_N'); U1[93] += pme
r = res('10k'); r[1] += vdd33; r[2] += pme
synclko = Net('SYNCLKO'); U1[95] += synclko
r = res('10k'); r[1] += vdd33; r[2] += synclko
iba = Net('IBA'); U1[67] += iba
r = res('1k'); r[1] += iba; r[2] += gnd

# KSZ port-7 SerDes (unused) -- leave SerDes I/O floating
U1[78] += Net('S_IN7M')
U1[79] += Net('S_IN7P')
U1[81] += Net('S_OUT7P')
U1[82] += Net('S_OUT7M')

# ============================================================
# Ports 1-5: KSZ PHY -> LPJG0926HENL PoE+ GbE MagJack.
# Integrated magnetics + LEDs + PoE center taps in one part.
# Each port uses all 4 pairs = full 1000BASE-T.
#
# LPJG0926HENL pinout (20 pins):
#   1=TD1+, 2=TD1-, 3=TD2+, 6=TD2-, 7=TD3+, 8=TD3-,
#   9=TD4+, 10=TD4-  (chip/PHY side MDI pairs)
#   4,5 = chip-side center taps (100nF to GND)
#   11=VC1, 12=VC2   (line-side CT, PoE V+)
#   13=VC3, 14=VC4   (line-side CT, PoE return)
#   15=GRN+, 16=GRN- (green LED)
#   17=YEL+, 18=YEL- (yellow LED)
#   S1,S2 = shield
# ============================================================
# KSZ MDI pins per port, pairs 1-4:
KSZ_PORT_MDI = {
  1: [(1, 2),   (4, 5),   (6, 7),   (8, 9)],
  2: [(12, 13), (15, 16), (17, 18), (20, 21)],
  3: [(24, 25), (26, 27), (28, 29), (31, 32)],
  4: [(34, 35), (37, 38), (39, 40), (42, 43)],
  5: [(112, 113), (115, 116), (117, 118), (120, 121)],
}
# MagJack chip-side MDI pin pairs (TD1..TD4 +/-)
MJ_P = [1, 3, 7, 9]    # TD1+, TD2+, TD3+, TD4+
MJ_N = [2, 6, 8, 10]   # TD1-, TD2-, TD3-, TD4-
PAIR = ['A', 'B', 'C', 'D']

# KSZ LED pins per port
KSZ_LEDS = {
  1: (105, 106), 2: (91, 92), 3: (88, 89),
  4: (85, 86),   5: (102, 103),
}

# PoE supply nets per port (from PSE FET section below)
poe_vp = {p: Net(f'POE_VP_{p}') for p in range(1, 6)}

for pn in range(1, 6):
  j = Part(
    tool=SKIDL, name='LPJG0926HENL', ref_prefix='J', dest=NETLIST,
    footprint='connectors:LPJG0926HENL',
    pins=[Pin(num=str(i), name=f'P{i}', func=Pin.types.PASSIVE)
          for i in range(1, 19)]
         + [Pin(num='S1', name='SH1', func=Pin.types.PASSIVE),
            Pin(num='S2', name='SH2', func=Pin.types.PASSIVE)])
  j.ref = f'J{pn + 1}'   # J2..J6

  # KSZ PHY pairs -> magjack chip-side MDI
  for idx in range(4):
    pp, pm = KSZ_PORT_MDI[pn][idx]
    np_ = Net(f'P{pn}_{PAIR[idx]}P')
    nm_ = Net(f'P{pn}_{PAIR[idx]}N')
    U1[pp] += np_; U1[pm] += nm_
    j[MJ_P[idx]] += np_; j[MJ_N[idx]] += nm_

  # Chip-side center taps (pins 4,5): 100nF to GND
