         3: (8, 9, 10),   4: (12, 13, 14)}
for port, (s, d, g) in U9_CH.items():
  wire_pse_channel(U9, s, d, g, poe_vp[port], f'Q{port}')
# KSENSA (ports 1,2) + KSENSB (ports 3,4) kelvin
ksa = Net('U9_KSENSA'); U9[18] += ksa
r = res('22'); r[1] += ksa; r[2] += gnd
ksb = Net('U9_KSENSB'); U9[11] += ksb
r = res('22'); r[1] += ksb; r[2] += gnd

# U13 -> port 5 (other 3 channels unused)
U13 = tps23861('U13')
wire_pse_common(U13, a3_to_gnd=False)  # addr differs
wire_pse_channel(U13, 15, 16, 17, poe_vp[5], 'Q5')
ksa = Net('U13_KSENSA'); U13[18] += ksa
r = res('22'); r[1] += ksa; r[2] += gnd
U13[11] += Net('U13_KSENSB')
# unused channels float
for s, d, g in [(19, 20, 21), (8, 9, 10), (12, 13, 14)]:
  U13[s] += Net(f'U13_SEN{s}')
  U13[d] += Net(f'U13_DRAIN{d}')
