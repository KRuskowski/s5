# ============================================================
# SUPERVISOR SUBSYSTEM -- always-on housekeeping MCU
#   STM32G071 (LQFP48) on a standby 3.3V rail: watchdogs the
#   T113 (drives SOC_RESET_N), reads 2x DS18B20 (1-Wire) + an
#   SHT4x (I2C humidity/temp for dew-point / condensation),
#   drives an alarm LED, and sits behind a DUMB thermal-switch
#   failsafe that asserts SOC_RESET_N on over-temp with no
#   firmware in the loop.  "Contain" layer of prevent+contain.
# ============================================================
# Standby 3.3V straight off PROTECTED 24V so the supervisor domain is
# INDEPENDENT of the main switched rails -- it rides through a main
# power-cycle. HV LDO (>=40V in); ~10-20mA standby => <0.4W, negligible
# vs the board's tens of W. Finalize the exact HV-LDO part in layout.
U18 = ldo_sot223('TPS7B6933QDCYRQ1', 'U18')
U18[3] += vin24; U18[2] += v3v3_sb; U18[1] += gnd
for _v, _fp in (('10uF', 'Capacitor_SMD:C_0805_2012Metric'),
                ('100nF', 'Capacitor_SMD:C_0402_1005Metric')):
  c = cap(_v, _fp); c[1] += v3v3_sb; c[2] += gnd

# PoE-logic 3.3V -- separate always-on rail off protected 24V, INDEPENDENT
# of MAIN_EN, so the PSE controllers hold the ports powered through a
# management power-cycle. EN defaults on (pull-up to standby); the STM can
# pull PSE_EN low to shed PoE -- the gentlest thermal action, dropping the
# board's biggest heat source before it ever has to halt the SoC.
U20 = ldo_sot223('TPS7B6933QDCYRQ1', 'U20')
U20[3] += vin24; U20[2] += vpse33; U20[1] += gnd
# PSE shared-reset pull-up (default high = PSEs run; STM pulls low to shed)
r = res('10k'); r[1] += vpse33; r[2] += pse_reset
for _v, _fp in (('10uF', 'Capacitor_SMD:C_0805_2012Metric'),
                ('100nF', 'Capacitor_SMD:C_0402_1005Metric')):
  c = cap(_v, _fp); c[1] += vpse33; c[2] += gnd

