  footprint='connectors:Relay_HFD23_1C_THT',
  pins=[Pin(num='1', name='NO',  func=Pin.types.PASSIVE),
        Pin(num='2', name='A2',  func=Pin.types.PASSIVE),
        Pin(num='3', name='COM', func=Pin.types.PASSIVE),
        Pin(num='4', name='NC',  func=Pin.types.PASSIVE),
        Pin(num='5', name='A1',  func=Pin.types.PASSIVE),
        Pin(num='6', name='COM', func=Pin.types.PASSIVE)])
