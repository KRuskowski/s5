(footprint Relay_HFD23_1C_THT (layer F.Cu) (tedit 5A000000)
  (descr "Hongfa HFD23 subminiature signal relay, 1 Form C (SPDT), through-hole. Body 12.5x7.5x10mm, 6x O1.0mm holes on 2.54mm grid (cols 0/2.54/10.16, rows +-2.54). Pads (top view): 1=NO 2=coil 3=COM 4=NC 5=coil 6=COM. Coil non-polar (2/5). COM doubled (3+6). VERIFY with a meter before committing: coil ~2.9k for 24V, COM-NC closed at rest.")
  (tags "relay HFD23 SPDT signal THT 24V")
  (attr through_hole)
  (fp_text reference REF** (at 0 -5.2 0) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value HFD23-024-1ZS (at 0 5.2 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_line (start -6.25 -3.75) (end 6.25 -3.75) (layer F.Fab) (width 0.1))
  (fp_line (start 6.25 -3.75) (end 6.25 3.75) (layer F.Fab) (width 0.1))
  (fp_line (start 6.25 3.75) (end -6.25 3.75) (layer F.Fab) (width 0.1))
  (fp_line (start -6.25 3.75) (end -6.25 -3.75) (layer F.Fab) (width 0.1))
  (fp_line (start -6.35 -3.85) (end 6.35 -3.85) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.35 -3.85) (end 6.35 3.85) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.35 3.85) (end -6.35 3.85) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.35 3.85) (end -6.35 -3.85) (layer F.SilkS) (width 0.12))
  (fp_circle (center 5.08 -4.35) (end 5.28 -4.35) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.7 -4.2) (end 6.7 -4.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.7 -4.2) (end 6.7 4.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.7 4.2) (end -6.7 4.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start -6.7 4.2) (end -6.7 -4.2) (layer F.CrtYd) (width 0.05))
  (pad 1 thru_hole rect (at 5.08 -2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 2.54 -2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at -5.08 -2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (pad 4 thru_hole circle (at 5.08 2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (pad 5 thru_hole circle (at 2.54 2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (pad 6 thru_hole circle (at -5.08 2.54) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  (model "${KIPRJMOD}/HFD23_box.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
